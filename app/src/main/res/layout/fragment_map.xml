<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.MapFragment">

    <!-- 1. EL MAPA (Al fondo) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map_container"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. EL BUSCADOR FALSO (Flotando en el mapa) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_buscador_falso"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#757575"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscar centro o facultad..."
                android:textColor="#757575"
                android:textSize="16sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. TARJETA DE INFORMACIÓN DE RUTAS (Oculta al inicio, flota sobre el selector) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_info_rutas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="250dp"
        app:layout_constraintBottom_toTopOf="@+id/card_transporte"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Usamos NestedScrollView para mejor compatibilidad con los scrolls -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/ll_lista_instrucciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" />

        </androidx.core.widget.NestedScrollView>

    </androidx.cardview.widget.CardView>

    <!-- 4. SELECTOR DE TRANSPORTE (Flotando en la parte inferior) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_transporte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <RadioGroup
            android:id="@+id/rg_modo_transporte"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <RadioButton
                android:id="@+id/rb_andando"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="A pie" />

            <RadioButton
                android:id="@+id/rb_bici"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Bici" />

            <RadioButton
                android:id="@+id/rb_transporte_publico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Público" />
        </RadioGroup>
    </com.google.android.material.card.MaterialCardView>

    <!-- 5. LA PANTALLA COMPLETA DE BÚSQUEDA (Oculta al inicio) -->
    <!-- Mantenemos la elevación a 10dp para que cubra todo el mapa y las tarjetas -->
    <LinearLayout
        android:id="@+id/pantalla_busqueda_completa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:visibility="gone"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/header_busqueda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/btn_cerrar_busqueda"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#333333"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchViewReal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:iconifiedByDefault="false"
                app:queryHint="¿A dónde quieres ir?"
                app:queryBackground="@android:color/transparent"
                app:searchIcon="@null" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"/>

        <ListView
            android:id="@+id/lv_search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#EEEEEE"
            android:dividerHeight="1dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>