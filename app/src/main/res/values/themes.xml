<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Unigodas" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Color principal: Rojo Bilbao -->
        <item name="colorPrimary">@color/bilbao_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/bilbao_red_dark</item>

        <!-- Color secundario: Gris oscuro Bilbao -->
        <item name="colorSecondary">@color/bilbao_grey_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Fondos y superficies -->
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/white</item>

        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="Theme.Unigodas" parent="Base.Theme.Unigodas" />

    <style name="CircleImageView" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="TemaVentanaFlotante" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item> </style>
</resources>