<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">


    <PreferenceCategory
        app:key="pref_category_profile"
        app:title="@string/pref_header_profile">

        <!-- Custom class used to handle the binding of the header layout -->
        <com.example.unigo_das.fragments.ProfileHeaderPreference
            app:key="pref_profile_header" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="pref_category_account"
        app:title="@string/pref_account_section">

        <Preference
            app:iconSpaceReserved="false"
            app:key="pref_my_account"
            app:title="@string/pref_my_account" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="pref_email_info"
            app:title="@string/email_label"
            app:selectable="false" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="pref_name_info"
            app:title="@string/name_label"
            app:selectable="false" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="pref_change_password"
            app:title="@string/change_password" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="pref_logout"
            app:title="@string/pref_logout" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="pref_login"
            app:title="@string/pref_login" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="pref_category_general"
        app:title="@string/pref_general_config">

        <Preference
            app:iconSpaceReserved="false"
            app:key="pref_language"
            app:title="@string/pref_language" />

        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:defaultValue="false"
            app:key="modo_oscuro_activado"
            app:title="@string/pref_dark_mode"
            app:summary="@string/pref_dark_mode_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        app:key="pref_category_mobility"
        app:title="@string/routes_and_transport">

        <Preference
            app:key="pref_transporte_favorito"
            app:title="@string/favorite_transport2"
            app:summary="@string/default_transport_mode"
            app:iconSpaceReserved="false"/>

        <SwitchPreferenceCompat
            app:key="pref_coche_electrico"
            app:title="@string/electric_vehicle"
            app:summary="@string/prioritize_charging_routes"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:key="pref_category_notifications"
        app:title="@string/alerts_and_weather">

        <SwitchPreferenceCompat
            app:key="pref_notificaciones_clima"
            app:title="@string/health_weather_notifications"
            app:summary="@string/daily_pollen_rain_uv_alerts"
            app:defaultValue="false"
            app:iconSpaceReserved="false"/>
        <Preference
            app:key="pref_hora_notificacion"
            app:title="@string/daily_alert_time"
            app:summary="7:30 AM"
            app:dependency="pref_notificaciones_clima"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:key="pref_category_map"
        app:title="@string/map_display">

        <Preference
            app:key="pref_tipo_mapa"
            app:title="@string/map_style2"
            app:summary="@string/normal"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:key="pref_category_info"
        app:title="@string/information">

        <Preference
            app:key="pref_open_data"
            app:title="@string/open_data_sources"
            app:summary="@string/thanks_to_partner_organizations"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="pref_equipo"
            app:title="@string/development_team"
            app:summary="@string/created_by_authors"
            app:selectable="false"
            app:iconSpaceReserved="false"/>

        <Preference
            app:key="pref_version"
            app:title="@string/app_version"
            app:summary="1.0.0"
            app:selectable="false"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

</PreferenceScreen>