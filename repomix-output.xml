<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchViewCentros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:iconifiedByDefault="false"
            app:queryHint="@string/search_centre"
            app:queryBackground="@android:color/transparent"/>
    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fillViewport="true"
        android:paddingHorizontal="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFiltroTodas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:minHeight="40dp"
                android:layout_marginEnd="6dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btnFiltroEHU"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EHU"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:minHeight="40dp"
                android:layout_marginEnd="6dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btnFiltroDeusto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deusto"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:minHeight="40dp"
                android:layout_marginEnd="6dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btnFiltroMondragon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mondragon"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:minHeight="40dp"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCentros"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp" /> <!-- Margen para que el BottomNav no tape el último -->

</LinearLayout>
</file>

