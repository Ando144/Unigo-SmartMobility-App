            case "EHU_EXP":
                 return R.drawable.foto_experiencia;

                // ==========================================
                // MONDRAGON UNIBERTSITATEA
                // ==========================================
            case "MU_BBF_EMP":
                 return R.drawable.foto_mondragon_empresariales_leinn;
            case "MU_BBF_LEINN":
