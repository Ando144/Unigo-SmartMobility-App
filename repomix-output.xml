        this.nombre = nombre;
        this.universidad = universidad;
        this.descripcion = descripcion;
        this.ubicacion = ubicacion;
        this.latitud = latitud;
        this.longitud = longitud;

        this.isStarred = false;
        this.isExpanded = false;
    }

    public String getId() { return id; }
