        <item name="colorPrimary">@color/bilbao_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorSurfaceVariant">#F5F5F5</item>
        <item name="colorOnSurfaceVariant">@color/text_medium</item>
    </style>

    <style name="CircleImageView" parent="">
        <item name="cornerSize">50%</item>
    </style>

