<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Unigodas" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Color principal: Rojo Bilbao -->
        <item name="colorPrimary">@color/bilbao_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/bilbao_red_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Color secundario: Gris oscuro Bilbao -->
        <item name="colorSecondary">@color/bilbao_grey_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Fondos y superficies (Modo Claro) -->
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorSurfaceVariant">#F5F5F5</item>
        <item name="colorOnSurfaceVariant">@color/text_medium</item>

        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="Theme.Unigodas" parent="Base.Theme.Unigodas" />

    <!-- Tema forzado en modo claro para Login y Registro -->
