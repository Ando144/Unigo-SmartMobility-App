            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFiltroTodas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:minHeight="40dp"
                android:layout_marginEnd="6dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btnFiltroEHU"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EHU"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:minHeight="40dp"
                android:layout_marginEnd="6dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btnFiltroDeusto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deusto"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:minHeight="40dp"
                android:layout_marginEnd="6dp"
                app:cornerRadius="16dp" />

            <Button
                android:id="@+id/btnFiltroMondragon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mondragon"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:minHeight="40dp"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCentros"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp" /> <!-- Margen para que el BottomNav no tape el último -->

</LinearLayout>
</file>

