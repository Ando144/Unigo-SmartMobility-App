                // ==========================================
                // UNIVERSIDAD DE DEUSTO
                // ==========================================
            case "DEU_DBS":
                 return R.drawable.foto_deusto;
            case "DEU_DER":
                return R.drawable.foto_deusto;
            case "DEU_CSH":
